# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.

# ---------------------------------------------------------------------------
# OBRIGATÓRIO EM PRODUÇÃO
# ---------------------------------------------------------------------------

# Segredo do servidor. Assina o cookie anti-CSRF.
# Gere um com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar este valor derruba as sessões abertas.
TRIAGEM_SECRET_KEY=

# ---------------------------------------------------------------------------
# CONTAS
# ---------------------------------------------------------------------------

# Cadastro aberto na tela de entrada. Deixe false para criar contas você mesmo.
PERMITIR_CADASTRO=true

# Se preenchido, o cadastro exige este código. É o meio-termo entre aberto e
# fechado: você manda o código para quem comprou.
CODIGO_CONVITE=

SESSAO_HORAS=12

# Marque true quando o site estiver atrás de HTTPS. Em HTTP local, deixe false
# ou o navegador descarta o cookie de sessão e o login nunca completa.
COOKIE_SEGURO=false

LOGIN_MAX_TENTATIVAS=8
LOGIN_JANELA_MIN=15

# ---------------------------------------------------------------------------
# LGPD
# ---------------------------------------------------------------------------

# Prazo padrão de guarda de currículo, em dias. Cada organização ajusta o dela
# na tela de Configurações. 180 dias cobre um processo seletivo com folga.
RETENCAO_DIAS_PADRAO=180

# De quanto em quanto tempo o expurgo roda. Ele também roda ao subir o servidor.
EXPURGO_INTERVALO_H=12

# Por quanto tempo o registro de auditoria fica guardado.
AUDITORIA_RETENCAO_DIAS=730

# ---------------------------------------------------------------------------
# UPLOAD
# ---------------------------------------------------------------------------

MAX_UPLOAD_MB=15
MAX_ARQUIVOS_POR_LOTE=30

# ---------------------------------------------------------------------------
# BACKUP
# ---------------------------------------------------------------------------
# O artefato sai cifrado com esta senha. Sem ela o backup automatico nao roda —
# e recusar e melhor que gravar em claro o banco de curriculos de todas as
# contas junto com o segredo que assina as sessoes.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# GUARDE ESTA SENHA FORA DO SERVIDOR. Sem ela o backup nao abre.

BACKUP_ATIVO=true
BACKUP_SENHA=
BACKUP_DIR=./backups
BACKUP_INTERVALO_H=24
BACKUP_DIARIOS=7
BACKUP_SEMANAIS=4

# Comando que leva o arquivo para fora da maquina. Backup no mesmo disco do
# banco nao e backup. `{arquivo}` vira o caminho do artefato recem-criado.
# Exemplos:
#   BACKUP_COMANDO_ENVIO=rclone copy {arquivo} remoto:triagem-backups/
#   BACKUP_COMANDO_ENVIO=scp {arquivo} usuario@outro-servidor:/backups/
BACKUP_COMANDO_ENVIO=

# ---------------------------------------------------------------------------
# RECUPERACAO DE SENHA
# ---------------------------------------------------------------------------
# 'email' (padrao): o servidor manda um link. E o unico caminho no modo
#          hospedado, onde o recrutador nao tem acesso a maquina.
# 'local':  instalacao na propria maquina (Claude Desktop por stdio). Quem
#          esqueceu a senha e dono do computador e resolve com:
#              python -m app.senha alguem@empresa.com
#          Nesse modo as rotas /recuperar e /redefinir nem existem.

RECUPERACAO_MODO=email
RECUPERACAO_MINUTOS=30
RECUPERACAO_MAX_PEDIDOS=5
RECUPERACAO_JANELA_MIN=60

# ---------------------------------------------------------------------------
# ENVIO DE E-MAIL (SMTP)
# ---------------------------------------------------------------------------
# Sem provedor no codigo: so host, porta e credencial. Trocar de relay e trocar
# estas variaveis. Deixe SMTP_HOST vazio para o e-mail ir para o log do
# servidor em vez de ser enviado — o fluxo continua inteiro, o que serve para
# desenvolvimento e para instalacao local.
#
# Atencao ao colocar em producao: provedor de VPS costuma bloquear a porta 25,
# e e-mail de dominio novo cai em spam. Use um relay transacional com SPF e
# DKIM configurados no dominio, senao o link nao chega na caixa de entrada.

SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=true
SMTP_REMETENTE=Triagem <nao-responda@seu-dominio.com.br>

# ---------------------------------------------------------------------------
# OCR DO PDF ESCANEADO
# ---------------------------------------------------------------------------
# Roda local, no Tesseract, sem custo e sem nada saindo da maquina. Exige o
# programa tesseract-ocr e o idioma tesseract-ocr-por instalados no servidor
# (a imagem Docker ja traz os dois). Sem eles, o PDF escaneado entra marcado
# com o motivo, em vez de quebrar o upload.

OCR_ATIVO=true
OCR_IDIOMA=por
# 300 DPI e onde o Tesseract acerta mais em papel digitalizado.
OCR_DPI=300
# Confianca media (0-100) abaixo da qual o currículo e marcado como leitura duvidosa.
OCR_CONFIANCA_MINIMA=75
OCR_MIN_PALAVRAS=40

# ---------------------------------------------------------------------------
# OUTROS
# ---------------------------------------------------------------------------

APP_NOME=Triagem
LOG_NIVEL=INFO

# Onde ficam o banco e os currículos. No Docker isso é um volume.
# TRIAGEM_DATA_DIR=/dados

# ---------------------------------------------------------------------------
# CONECTOR DO CLAUDE (MCP)
# ---------------------------------------------------------------------------

# Endereço público deste servidor. O conector do claude.ai usa isto para achar
# os endpoints de OAuth, então precisa ser EXATAMENTE o endereço que o navegador
# alcança — com https, sem barra no final. Se estiver errado, o login do
# conector redireciona para o lugar errado e a conexão nunca fecha.
TRIAGEM_BASE_URL=http://127.0.0.1:8000

# Desligue se você não quer expor o conector.
MCP_ATIVO=true

# Validade do acesso que o conector recebe. O refresh renova sem novo login.
MCP_TOKEN_HORAS=12
MCP_REFRESH_DIAS=30

# Quantos currículos o Claude pode puxar por chamada. Lote grande piora a
# avaliação: o modelo passa a comparar candidatos em vez de medir cada um
# contra a rubrica.
MCP_LOTE_MAX=5
